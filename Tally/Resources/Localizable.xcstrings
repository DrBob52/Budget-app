    },
    "Subscriptions": {
      "comment": "Starter category name.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripciones"
          }
        }
      }
    },
    "Subscriptions renew automatically at the price shown unless cancelled at least 24 hours before the end of the current period. Payment is charged to your Apple ID when you confirm the purchase. Manage or cancel any time in your Apple ID settings. Any free trial is for new subscribers only and converts to a paid plan when it ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente al precio indicado, salvo que las canceles al menos 24 horas antes de que termine el periodo actual. El pago se carga a tu Apple ID cuando confirmas la compra. Puedes gestionar o cancelar en cualquier momento en los ajustes de tu Apple ID. Cualquier prueba gratuita es solo para nuevos suscriptores y se convierte en un plan de pago cuando termina."
          }
        }
      }
    },
    "Suggested payments": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagos sugeridos"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        }
      }
    },
    "Tally": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally"
          }
        }
      }
    },
    "Tally Pro": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally Pro"
          }
        }
      }
    },
    "Tally has no accounts and no tracking. Budgets and transactions are stored only on your device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally no requiere cuenta ni te rastrea. Los presupuestos y movimientos se guardan solo en tu dispositivo."
          }
        }
      }
    },
    "Tally shows": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally muestra"
          }
        }
      }
    },
    "Tally starts a fresh budget at the rhythm of your pay, so the numbers line up with real life.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tally inicia un presupuesto nuevo al ritmo de tu pago, para que las cifras coincidan con la vida real."
          }
        }
      }
    },
