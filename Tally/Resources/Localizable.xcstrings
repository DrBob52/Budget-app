          }
        }
      }
    },
    "Thank you for backing Tally. Every Pro feature is unlocked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por apoyar a Tally. Todas las funciones Pro están desbloqueadas."
          }
        }
      }
    },
    "That amount is too small to log.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese importe es demasiado pequeño para registrarlo."
          }
        }
      }
    },
    "That amount needs to be more than zero.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El importe debe ser mayor que cero."
          }
        }
      }
    },
    "The App Store could not verify this purchase.": {
      "localizations": {
        "es": {
          "stringUnit": {
